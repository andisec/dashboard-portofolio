# npm configuration
# https://docs.npmjs.com/cli/v8/configuring-npm/npmrc

# Save exact versions
save-exact=true

# Auto-save dependencies
save=true

# Use HTTPS for registry
registry=https://registry.npmjs.org/

# Audit settings
audit=true

# Fund messages
fund=true

# Progress bar
progress=true

# Log level
loglevel=warn
